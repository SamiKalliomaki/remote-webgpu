{
  "name": "remote-webgpu-example-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --sourcemap --outfile=dist/main.js",
    "serve": "esbuild src/main.ts --bundle --format=esm --sourcemap --outfile=dist/main.js --servedir=. --serve=127.0.0.1:8000",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "remote-webgpu-client": "file:../client"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.60",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
